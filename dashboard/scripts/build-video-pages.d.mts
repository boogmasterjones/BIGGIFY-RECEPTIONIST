// Types for build-video-pages.mjs (used by tests/video-pages.test.ts).
export type VideoConfig = { youtube: Record<string, { id: string; uploaded?: string; title?: string }>; draft: Record<string, string> };
export type VideoPage = { slug: string; kind: 'video' | 'guide'; path: string; title: string; description: string; topic?: string; scripts?: string[]; faq?: [string, string][]; file: string };
export const TOPICS: [string, string, string][];
export function parseVideoConfig(source: string): VideoConfig;
export type ReadingLevel = { grade: number; words: number; sentences: number; hardWords: string[]; longSentences: { words: number; start: string }[] };
export type PageReading = { file: string; path: string; grade: number; words: number; longSentences: { words: number; start: string }[]; hardWords: string[]; tooHard: boolean; warn: boolean };
export function build(opts?: { write?: boolean; config?: VideoConfig }): { files: Map<string, string>; pages: VideoPage[]; live: VideoPage[]; drafts: VideoPage[]; guides: VideoPage[]; reading: PageReading[] };
export const READING_MAX_GRADE: number;
export const READING_MAX_SENTENCE_WORDS: number;
export const READING_LONG_SENTENCES_FAIL: boolean;
export function splitSentences(text: string): string[];
export function syllables(word: string): number;
export function readingLevel(text: string): ReadingLevel;
export function pageReadingText(p: Partial<VideoPage> & { body?: string; summary?: string; card?: string; resource?: { text?: string }; next?: string[] }): string;
export function readingReport(pages: VideoPage[]): PageReading[];
export function readingSummary(reading: PageReading[]): string;
export const SITE: string;
export const BYLINE: string;
export const ORGANIZATION: Record<string, unknown>;
export const PERSON: Record<string, unknown>;
export const WEBSITE: Record<string, unknown>;
export function pageTitle(title: string, file?: string): string;
