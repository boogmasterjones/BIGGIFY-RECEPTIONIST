# ---- Biggify AI Receptionist — environment variables ----
# Copy this file to ".env" and fill in your real values.
# The server runs even if some are missing (it falls back to mock/log mode),
# so you can demo the voice + booking flow before every integration is live.

# Public base URL of THIS server, reachable by Twilio (e.g. an ngrok https URL,
# or your Render/Railway deploy). No trailing slash.
# Example: https://biggify-abc123.ngrok-free.app
PUBLIC_URL=

# Port the server listens on (Render/Railway set PORT automatically).
PORT=8080

# ---- Anthropic (Claude) ----
ANTHROPIC_API_KEY=
# Model for the receptionist. Default is claude-sonnet-5 (fast, good for live voice).
# claude-haiku-4-5 = even faster; claude-opus-5 = smartest but slower on a call.
CLAUDE_MODEL=claude-sonnet-5

# ---- Twilio ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The Twilio number that answers calls AND sends the SMS survey (E.164, e.g. +15551234567).
TWILIO_PHONE_NUMBER=
# Optional Messaging Service SID (recommended once 10DLC is approved).
TWILIO_MESSAGING_SERVICE_SID=

# ---- Cal.com (booking) ----
# Leave blank to run in MOCK mode (fake but realistic slots) for the demo.
CALCOM_API_KEY=
CALCOM_EVENT_TYPE_ID=

# ---- Email alerts (owner notifications) ----
# Gmail: turn on 2-Step Verification, then create an App Password
# (Google Account -> Security -> App passwords) and paste it as SMTP_PASS.
# SMTP_USER is the full sending Gmail address. Leave blank to run in log-only mode.
SMTP_USER=gobiggify@gmail.com
SMTP_PASS=
# Optional: use a non-Gmail SMTP server instead.
# SMTP_HOST=
# SMTP_PORT=587

# ---- The business this receptionist represents ----
# This line is Biggify's OWN receptionist (the demo line on the website +
# Biggify's inbound leads), not a client business.
BUSINESS_NAME=Biggify
BUSINESS_TRADE=AI receptionist, SEO, web design, and lead generation for home-service businesses
BUSINESS_SERVICES=AI receptionists and 24/7 call answering, appointment booking, lead capture, local SEO, website design, and lead generation for home-service businesses
BUSINESS_HOURS=7 days a week, 8am to 8pm ET
BUSINESS_SERVICE_AREA=home-service businesses across the U.S.
# Optional: override the spoken opening line. Leave blank to use the default.
BUSINESS_GREETING=
# Where new-lead alerts go. EMAIL is the primary channel.
OWNER_ALERT_EMAIL=gobiggify@gmail.com
OWNER_ALERT_PHONE=

# ---- Voice persona (ConversationRelay TTS voice) ----
# Examples: "en-US-Journey-O" (Google), "Polly.Joanna-Neural" (Amazon).
RECEPTIONIST_VOICE=en-US-Journey-O
