# ---- Biggify AI Receptionist — environment variables ----
# Copy this file to ".env" and fill in your real values.
# The server runs even if some are missing (it falls back to mock/log mode),
# so you can demo the voice + booking flow before every integration is live.

# Public base URL of THIS server, reachable by Twilio (e.g. an ngrok https URL,
# or your Render/Railway deploy). No trailing slash.
# Example: https://biggify-abc123.ngrok-free.app
PUBLIC_URL=

# Port the server listens on (Render/Railway set PORT automatically).
PORT=8080

# ---- Anthropic (Claude) ----
ANTHROPIC_API_KEY=
# Model for the receptionist. Default is claude-opus-5.
# For lower voice latency you can switch to claude-sonnet-5 or claude-haiku-4-5.
CLAUDE_MODEL=claude-opus-5

# ---- Twilio ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The Twilio number that answers calls AND sends the SMS survey (E.164, e.g. +15551234567).
TWILIO_PHONE_NUMBER=
# Optional Messaging Service SID (recommended once 10DLC is approved).
TWILIO_MESSAGING_SERVICE_SID=

# ---- Cal.com (booking) ----
# Leave blank to run in MOCK mode (fake but realistic slots) for the demo.
CALCOM_API_KEY=
CALCOM_EVENT_TYPE_ID=

# ---- The client business (what the AI represents) ----
BUSINESS_NAME=Bob's HVAC
BUSINESS_TRADE=HVAC and heating/cooling
BUSINESS_HOURS=Monday to Friday, 8am to 6pm
BUSINESS_SERVICE_AREA=the greater Tampa area
# Where new-lead alerts go (the owner's phone / email).
OWNER_ALERT_PHONE=
OWNER_ALERT_EMAIL=

# ---- Voice persona (ConversationRelay TTS voice) ----
# Examples: "en-US-Journey-O" (Google), "Polly.Joanna-Neural" (Amazon).
RECEPTIONIST_VOICE=en-US-Journey-O
